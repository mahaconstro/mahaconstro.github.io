    "page2.html": {
      "settings": {
        "title": "ajlakshami Palace — The Grandeur of Timeless Architecture",
        "order": "3",
        "meta_descr": "Inspired by the grandeur of classical European architecture, this neo-classical residence expresses timeless elegance through monumental columns, symmetrical composition, ornate mouldings, and carefully proportioned architectural elements. Rich material selections and sophisticated detailing enhance its stately character, while contemporary comforts bring the traditional aesthetic into modern living. The result is a distinguished residence defined by grandeur, balance, and enduring appeal."
      },
      "components": [
        {
          "alias": false,
