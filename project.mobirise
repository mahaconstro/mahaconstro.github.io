    "page6.html": {
      "settings": {
        "title": "Lakshmi Sadan — A Distinct Expression of Modern Living",
        "order": "7",
        "meta_descr": "Rooted in contemporary design principles, this bungalow combines crisp geometric volumes with a nuanced interplay of textures and materials. Distinctive facade treatments establish depth and visual interest, while landscape lighting highlights the architectural composition throughout the evening. The design balances a strong exterior presence with the comfort and practicality expected of a thoughtfully designed private residence."
      },
      "components": [
        {
          "alias": false,
          "_styles": {
