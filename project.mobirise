          "_name": "menu2",
          "_sourceTheme": "mobirise5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"menu menu2\" group=\"Menu\" plugins=\"DropDown, TouchSwipe\" always-top global once=\"menu\" not-draggable position-absolute>\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" name=\"fullWidth\" title=\"Full Width\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Logo\" name=\"showLogo\" checked>\n        <input type=\"range\" title=\"Logo Size\" inline name=\"logoSize\" min=\"3\" max=\"8\" step=\"0.1\" value=\"4.4\" condition=\"showLogo\">\n        <input type=\"checkbox\" title=\"Brand Name\" name=\"showBrand\">\n        <input type=\"checkbox\" title=\"Menu Items\" name=\"showItems\" checked>\n        <input type=\"checkbox\" title=\"Icons\" name=\"showIcons\">\n        <select title=\"Amount\" name=\"iconsAmount\" condition=\"showIcons\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\" selected>3</option>\n            <option value=\"4\">4</option>\n        </select>\n        <input type=\"color\" title=\"Icons Color\" name=\"iconsColor\" value=\"#000000\" condition=\"showIcons\">\n        <input type=\"checkbox\" title=\"Button\" name=\"showButtons\" checked>\n        <header>Styles</header>\n        <input type=\"checkbox\" title=\"Sticky\" name=\"sticky\" checked>\n        <input type=\"checkbox\" title=\"Collapsed\" name=\"collapsed\">\n        <input type=\"checkbox\" title=\"Transparent\" name=\"transparent\">\n        <input type=\"range\" title=\"Opacity\" name=\"opacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.2\" condition=\"transparent\">\n        <input type=\"color\" title=\"Color\" name=\"menuBgColor\" value=\"#ffffff\">\n        <input type=\"color\" title=\"Hamburger\" name=\"hamburgerColor\" value=\"#000000\">\n    </mbr-parameters>\n    <nav class=\"navbar navbar-dropdown\" mbr-class=\"{'navbar-fixed-top':sticky,\n                    'navbar-expand-lg':!collapsed,\n                    'collapsed':collapsed}\">\n        <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n            <div class=\"navbar-brand\">\n                <span mbr-if=\"showLogo\" class=\"navbar-logo\">\n                    \n                        <img src=\"@PROJECT_PATH@/assets/images/mahaconstro20logo-435x140.webp\" alt=\"mahaconstro logo\" mbr-style=\"{'height': logoSize + 'rem'}\">\n                    \n                </span>\n                <span mbr-if=\"showBrand\" mbr-buttons mbr-theme-style=\"display-7\" class=\"navbar-caption-wrap\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd,-mbrBtnRemove,-iconFont\"><a class=\"navbar-caption text-black\" data-app-selector=\".navbar-caption\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">Mobirise</a></span>\n            </div>\n            <button class=\"navbar-toggler\" type=\"button\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-target=\"#navbarSupportedContent\" data-bs-target=\"#navbarSupportedContent\" aria-controls=\"navbarNavAltMarkup\" aria-expanded=\"false\" aria-label=\"Toggle navigation\" mbr-if=\"showItems || showIcons || showButtons\">\n                <div class=\"hamburger\">\n                    <span></span>\n                    <span></span>\n                    <span></span>\n                    <span></span>\n                </div>\n            </button>\n            <div class=\"collapse navbar-collapse\" id=\"navbarSupportedContent\" mbr-if=\"showItems || showIcons || showButtons\">\n                <ul mbr-menu class=\"navbar-nav nav-dropdown\" mbr-theme-style=\"display-4\" mbr-if=\"showItems\" mbr-class=\"{'nav-right': !showButtons,'navbar-nav-top-padding': isPublish && !showBrand && !showLogo}\"><li class=\"nav-item\"><a class=\"nav-link link text-black text-primary\" href=\"index.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Home</a></li><li class=\"nav-item\"><a class=\"nav-link link text-black text-primary\" href=\"index.html#features9-t\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">\n                            About us</a></li>\n                    <li class=\"nav-item\"><a class=\"nav-link link text-black text-primary\" href=\"index.html#design-block-6\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">\n                            Services</a></li><li class=\"nav-item\"><a class=\"nav-link link text-black text-primary\" href=\"index.html#gallery1-1n\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Projects</a></li></ul>\n                <div class=\"icons-menu\" mbr-if=\"showIcons\">\n                    <a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" target=\"_blank\">\n                        <span mbr-icon class=\"p-2 mbr-iconfont socicon-facebook socicon\"></span>\n                    </a>\n                    <a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" target=\"_blank\" mbr-if=\"iconsAmount > 1\">\n                        <span mbr-icon class=\"p-2 mbr-iconfont socicon-twitter socicon\"></span>\n                    </a>\n                    <a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" target=\"_blank\" mbr-if=\"iconsAmount > 2\">\n                        <span mbr-icon class=\"p-2 mbr-iconfont socicon-instagram socicon\"></span>\n                    </a>\n                    <a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" target=\"_blank\" mbr-if=\"iconsAmount > 3\">\n                        <span mbr-icon class=\"p-2 mbr-iconfont socicon-linkedin socicon\"></span>\n                    </a>\n                </div>\n                <div mbr-if=\"showButtons\" mbr-buttons mbr-theme-style=\"display-4\" class=\"navbar-buttons mbr-section-btn\"><a class=\"btn btn-primary\" href=\"https://wa.me/9922057515\" data-app-placeholder=\"Type Text\">\n                        Contact Now</a></div>\n            </div>\n        </div>\n    </nav>\n</section>",
          "_cid": "vytZaZJSAk",
          "_anchor": "menu2-4",
          "_protectedParams": [],
          "_global": true,
          "_once": "menu",
          "_params": {}
        },
        {
          "alias": "witsec-code-editor/components",
          "_isSecondary": true,
          "_styles": {
            "#mahaconstro-intro": {
              "position": "fixed !important",
              "top": "0 !important",
              "left": "0 !important",
              "right": "0 !important",
              "bottom": "0 !important",
              "width": "100% !important",
              "height": "100dvh !important",
              "z-index": "2147483647 !important",
              "background-color": "#171717 !important",
              "display": "flex !important",
              "align-items": "center !important",
              "justify-content": "center !important",
              "opacity": "1",
              "visibility": "visible",
              "pointer-events": "auto",
              "transition": "opacity 2s ease-in-out, visibility 2s ease-in-out !important"
            },
            "#mahaconstro-intro .intro-content": {
              "text-align": "center",
              "padding": "20px",
              "width": "100%",
              "box-sizing": "border-box"
            },
            "#mahaconstro-intro .intro-name": {
              "color": "#c7b89a",
              "font-family": "\"Montserrat\", Arial, sans-serif !important",
              "font-weight": "700 !important",
              "font-size": "30px",
              "letter-spacing": "5px",
              "line-height": "1.3",
              "opacity": "0",
              "animation": "mcIntroText 1s ease 0.2s forwards"
            },
            "#mahaconstro-intro .intro-line": {
              "width": "0",
              "max-width": "310px",
              "height": "1px",
              "background-color": "#c7b89a",
              "margin": "18px auto",
              "animation": "mcIntroLine 0.8s ease 0.5s forwards"
            },
            "#mahaconstro-intro .intro-subtitle": {
              "color": "#ffffff",
              "font-family": "Arial, Helvetica, sans-serif",
              "font-size": "11px",
              "font-weight": "400",
              "letter-spacing": "4px",
              "opacity": "0",
              "animation": "mcIntroText 0.8s ease 0.8s forwards"
            },
            "@keyframes mcIntroText": {
              "from": {
                "opacity": "0",
                "transform": "translateY(8px)"
              },
              "to": {
                "opacity": "1",
                "transform": "translateY(0)"
              }
            },
            "@keyframes mcIntroLine": {
              "from": {
                "width": "0"
              },
              "to": {
                "width": "65%"
              }
            },
            "#mahaconstro-intro.intro-hidden": {
              "opacity": "0 !important",
              "visibility": "hidden !important",
              "pointer-events": "none !important"
            },
            "@media screen and (max-width: 600px)": {
              "#mahaconstro-intro .intro-name": {
                "font-size": "25px",
                "letter-spacing": "3px"
              },
              "#mahaconstro-intro .intro-subtitle": {
                "font-size": "10px",
                "letter-spacing": "3px"
              },
              "#mahaconstro-intro .intro-line": {
                "max-width": "220px"
              }
            },
            "@media (prefers-reduced-motion: reduce)": {
              "#mahaconstro-intro .intro-name, #mahaconstro-intro .intro-line, #mahaconstro-intro .intro-subtitle": {
                "animation-duration": "0.01ms",
                "animation-delay": "0s"
              }
            }
          },
          "_name": "witsec-html-block",
          "_sourceTheme": "mobirise5",
          "_customHTML": "<link href=\"https://fonts.googleapis.com/css2?family=Montserrat:wght@500;700&display=swap\" rel=\"stylesheet\">\r\n<section class=\"mbr-section\">\r\n  <div id=\"mahaconstro-intro\">\r\n    <div class=\"intro-content\">\r\n      <div class=\"intro-name\">MAHACONSTRO</div>\r\n      <div class=\"intro-line\"></div>\r\n      <div class=\"intro-subtitle\">LED BY ABHIJIT MANE AND ASSOCIATES</div>\r\n    </div>\r\n  </div>\r\n</section>\r\n\r\n<script>\r\n(function () {\r\n  var intro = document.getElementById(\"mahaconstro-intro\");\r\n  if (!intro) return;\r\n\r\n  window.setTimeout(function () {\r\n    intro.classList.add(\"intro-hidden\");\r\n  }, 2200);\r\n})();\r\n</script>\r\n",
          "_cid": "vytPW1X2Nw",
          "_anchor": "witsec-html-block-0",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".social-row": {
              ".soc-item": {
                "display": "inline-block",
                "text-align": "center",
                "margin-bottom": "1rem",
                "margin-right": ".7rem",
                ".mbr-iconfont": {
                  "font-size": "32px",
                  "border-radius": "50%",
                  "padding": "0.6rem",
                  "border": "2px solid @socialIconColor",
                  "transition": "all 0.3s",
                  "color": "@socialIconColor",
                  "&:hover": {
                    "background-color": "@socialIconColor",
                    "color": "contrast(@socialIconColor)"
                  }
                }
              }
            },
            ".mbr-section-subtitle": {
              "color": "#e6c63b"
            },
            ".mbr-section-title": {
              "color": "#e6c63b"
            }
          },
          "_name": "header13",
          "_sourceTheme": "mobirise5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"header13\" group=\"Headers\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"7\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"6\" condition=\"fullScreen == false\">\n\n        <input type=\"range\" inline name=\"textWidth\" title=\"Width\" min=\"4\" max=\"12\" value=\"7\" step=\"1\">\n        <select title=\"Align\" name=\"contentAlign\">\n            <option value>Left</option>\n            <option value=\"justify-content-center\" selected>Center</option>\n            <option value=\"justify-content-end\">Right</option>\n        </select>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubitle\">\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n        <input type=\"checkbox\" title=\"Social\" name=\"showSocial\">\n        <input type=\"range\" name=\"socialCount\" title=\"Count\" min=\"1\" max=\"5\" step=\"1\" value=\"3\" condition=\"showSocial\">\n        <input type=\"color\" title=\"Color\" name=\"socialIconColor\" value=\"#000000\" condition=\"showSocial\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background15.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#40b0bf\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background13.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.2\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div class=\"align-center\" mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row {{contentAlign}}\">\n            <div class=\"col-12 col-lg-{{textWidth}}\">\n                <h1 class=\"mbr-section-title mbr-fonts-style mb-3\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\"><b>From Imagination to Reality</b></h1>\n                <h2 class=\"mbr-section-subtitle mbr-fonts-style mb-3\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-2\" mbr-if=\"showSubitle\"><b>From Imagination to Reality</b></h2>\n                <p class=\"mbr-text mbr-fonts-style mb-3\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn, .social-row\">\n                    Every idea has a possibility. Every space has a story. We bring them together through design.\n                </p>\n                <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn mt-3\" mbr-if=\"showButtons\"><a class=\"btn btn-primary\" href=\"index.html#header13-v\" data-app-placeholder=\"Type Text\">Explore Our Projects</a></div>\n                <div class=\"social-row display-7 mt-5\" mbr-if=\"showSocial\">\n                    <div class=\"soc-item\">\n                        <a href=\"https://twitter.com/mobirise\" target=\"_blank\">\n                            <span mbr-icon class=\"mbr-iconfont socicon socicon-facebook\"></span>\n                        </a>\n                    </div>\n                    <div class=\"soc-item\" mbr-if=\"socialCount>1\">\n                        <a href=\"https://twitter.com/mobirise\" target=\"_blank\">\n                            <span mbr-icon class=\"mbr-iconfont socicon socicon-twitter\"></span>\n                        </a>\n                    </div>\n                    <div class=\"soc-item\" mbr-if=\"socialCount>2\">\n                        <a href=\"https://twitter.com/mobirise\" target=\"_blank\">\n                            <span mbr-icon class=\"mbr-iconfont socicon socicon-instagram\"></span>\n                        </a>\n                    </div>\n                    <div class=\"soc-item\" mbr-if=\"socialCount>3\">\n                        <a href=\"https://twitter.com/mobirise\" target=\"_blank\">\n                            <span mbr-icon class=\"mbr-iconfont socicon socicon-youtube\"></span>\n                        </a>\n                    </div>\n                    <div class=\"soc-item\" mbr-if=\"socialCount>4\">\n                        <a href=\"https://twitter.com/mobirise\" target=\"_blank\">\n                            <span mbr-icon class=\"mbr-iconfont socicon socicon-telegram\"></span>\n                        </a>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "vyubBcYdo2",
          "_anchor": "header13-c",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".mbr-section-title": {
              "color": "#ffffff"
            }
          },
          "_name": "info1",
          "_sourceTheme": "mobirise5",
          "_customHTML": "<section data-bs-version=\"5.1\" group=\"Features\" class=\"info1\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"2\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"2\" condition=\"fullScreen == false\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\">\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\">\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background3.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#bbbbbb\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background13.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#4479d9\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n    <div class=\"align-center\" mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-12 col-lg-8\">\n                <h3 class=\"mbr-section-title mb-4 mbr-fonts-style\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-1\" mbr-if=\"showTitle\">\n                    <b>Join our community on Mobirise Forums.</b>\n                </h3>\n                <p class=\"mbr-text mb-5 mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\">\n                    Mobirise is a free offline app for Windows and Mac to easily create small/medium websites, landing pages, online resumes and portfolios. 3100+ beautiful website blocks, templates and themes help you to start easily.\n                </p>\n                <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-info\" data-app-placeholder=\"Type Text\">SERVICES</a></div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "vyuMGr18fV",
          "_anchor": "info1-g",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_name": "design-block",
          "_sourceTheme": "mobirise5",
          "_styles": {
            "h1, p, img": {
              "margin": "0",
              "padding": "0",
              "border": "0",
              "outline": "0",
              "font-size": "100%",
              "vertical-align": "baseline",
              "background": "transparent",
              "text-decoration": "none"
            },
            "html": {
              "scroll-behavior": "smooth"
            },
            "@media (max-width: 991px)": {
              "aside": {
                "display": "none"
              }
            },
            "aside": {
              "& when (@showPossDots)": {
                "left": "(@DotsSpacing * 1px)"
              },
              "& when (@showPossDots = false)": {
                "right": "(@DotsSpacing * 1px)"
              },
              "z-index": "1000",
              "position": "fixed",
              "top": "50%",
              "transform": "translate(-50%, -50%)"
            },
            "aside ul": {
              "display": "flex",
              "flex-direction": "column",
              "align-items": "center",
              "list-style-type": "none",
              "margin": "0"
            },
            "aside ul li .indicator": {
              "cursor": "pointer",
              "margin-top": "1rem",
              "display": "block",
              "height": "(@DotsSize * 1px)",
              "width": "(@DotsSize * 1px)",
              "border-radius": "(@DotsRadius * 0.5%)",
              "background-color": "@IndicColor"
            },
            "aside ul li .active": {
              "transform": "scale(@DotsActSize)",
              "transition": "transform 200ms ease-in-out",
              "background-color": "@IndicColorAct"
            },
            "div.imgtest": {
              "content": "url(@Test1)",
              "width": "100% !important",
              "height": "100% !important",
              "object-fit": "cover",
              "font-family": "'object-fit: cover;'",
              "opacity": "@OpacityImage1",
              "-webkit-filter": "blur(@BlurImage1 * 1px) grayscale(@GrayImage1)",
              "-moz-filter": "blur(@BlurImage1 * 1px) grayscale(@GrayImage1)",
              "-o-filter": "blur(@BlurImage1 * 1px) grayscale(@GrayImage1)",
              "-ms-filter": "blur(@BlurImage1 * 1px) grayscale(@GrayImage1)",
              "filter": "blur(@BlurImage1 * 1px) grayscale(@GrayImage1)"
            },
            "div.imgtest1": {
              "content": "url(@Test2)",
              "width": "100% !important",
              "height": "100% !important",
              "object-fit": "cover",
              "font-family": "'object-fit: cover;'",
              "opacity": "@OpacityImage2",
              "-webkit-filter": "blur(@BlurImage2 * 1px) grayscale(@GrayImage2)",
              "-moz-filter": "blur(@BlurImage2 * 1px) grayscale(@GrayImage2)",
              "-o-filter": "blur(@BlurImage2 * 1px) grayscale(@GrayImage2)",
              "-ms-filter": "blur(@BlurImage2 * 1px) grayscale(@GrayImage2)",
              "filter": "blur(@BlurImage2 * 1px) grayscale(@GrayImage2)"
            },
            "div.imgtest2": {
              "content": "url(@Test3)",
              "width": "100% !important",
              "height": "100% !important",
              "object-fit": "cover",
              "font-family": "'object-fit: cover;'",
              "opacity": "@OpacityImage3",
              "-webkit-filter": "blur(@BlurImage3 * 1px) grayscale(@GrayImage3)",
              "-moz-filter": "blur(@BlurImage3 * 1px) grayscale(@GrayImage3)",
              "-o-filter": "blur(@BlurImage3 * 1px) grayscale(@GrayImage3)",
              "-ms-filter": "blur(@BlurImage3 * 1px) grayscale(@GrayImage3)",
              "filter": "blur(@BlurImage3 * 1px) grayscale(@GrayImage3)"
            },
            "div.imgtest3": {
              "content": "url(@Test4)",
              "width": "100% !important",
              "height": "100% !important",
              "object-fit": "cover",
              "font-family": "'object-fit: cover;'",
              "opacity": "@OpacityImage4",
              "-webkit-filter": "blur(@BlurImage4 * 1px) grayscale(@GrayImage4)",
              "-moz-filter": "blur(@BlurImage4 * 1px) grayscale(@GrayImage4)",
              "-o-filter": "blur(@BlurImage4 * 1px) grayscale(@GrayImage4)",
              "-ms-filter": "blur(@BlurImage4 * 1px) grayscale(@GrayImage4)",
              "filter": "blur(@BlurImage4 * 1px) grayscale(@GrayImage4)"
            },
            "div.imgtest4": {
              "content": "url(@Test5)",
              "width": "100% !important",
              "height": "100% !important",
              "object-fit": "cover",
              "font-family": "'object-fit: cover;'",
              "opacity": "@OpacityImage5",
              "-webkit-filter": "blur(@BlurImage5 * 1px) grayscale(@GrayImage5)",
              "-moz-filter": "blur(@BlurImage5 * 1px) grayscale(@GrayImage5)",
              "-o-filter": "blur(@BlurImage5 * 1px) grayscale(@GrayImage5)",
              "-ms-filter": "blur(@BlurImage5 * 1px) grayscale(@GrayImage5)",
              "filter": "blur(@BlurImage5 * 1px) grayscale(@GrayImage5)"
            },
            ".split .split-image.object-cover img, .slide-image.object-cover img .grid-image img, .video-wrap .poster img": {
              "width": "100% !important",
              "height": "100% !important",
              "object-fit": "cover",
              "font-family": "'object-fit: cover;'"
            },
            ".slide-image.object-contain video, .slide-image.object-contain img": {
              "width": "100% !important",
              "height": "100% !important",
              "object-fit": "contain",
              "font-family": "'object-fit: contain;'"
            },
            ".home-hero .safari-fix a, .fullscreen a": {
              "background": "none !important",
              "text-shadow": "none !important"
            },
            ".wrap": {
              "padding": "3rem",
              "display": "block",
              "width": "100%"
            },
            "@media only screen and (min-width: 700px)": {
              ".wrap": {
                "padding": "6rem"
              },
              "p + p": {
                "margin-top": "2rem"
              }
            },
            "@media only screen and (min-width: 1024px)": {
              ".wrap": {
                "padding": "6rem 6rem 5.4rem"
              },
              "section:last-child .wrap, .wrap:last-child": {
                "padding-bottom": "6rem"
              },
              ".wrap.align-center q": {
                "padding": "0 3rem"
              }
            },
            "@media only screen and (min-width: 1400px)": {
              ".wrap": {
                "padding": "8.2rem 6rem 7.6rem"
              },
              "section:last-child .wrap, .wrap:last-child": {
                "padding-bottom": "8.2rem"
              }
            },
            "input, textarea, button, select, body": {
              "font-family": "acumin-pro, Helvetica, Arial, sans-serif",
              "font-style": "normal"
            },
            "h1": {
              "font-weight": "600",
              "font-size": "3rem",
              "line-height": "1.16666667"
            },
            "body": {
              "width": "100%",
              "min-height": "100%",
              "font-size": "2rem",
              "line-height": "1.45",
              "overflow-x": "hidden"
            },
            "@media only screen and (min-width: 700px) and (min-height: 500px)": {
              "h1": {
                "font-size": "calc(3.6rem + 1vw)"
              }
            },
            "h1 + button": {
              "margin-top": "2rem"
            },
            "h1 + p": {
              "margin-top": "1rem"
            },
            "p + p": {
              "margin-top": "1.6rem"
            },
            "img": {
              "display": "block",
              "max-width": "100%"
            },
            "img::after": {
              "content": "\"🖼️\" attr(alt)",
              "font-size": "1.4rem",
              "display": "block",
              "position": "absolute",
              "z-index": "2",
              "top": "0",
              "left": "0",
              "width": "100%",
              "min-width": "4.5rem",
              "height": "100%",
              "padding": "1.5rem",
              "background-color": "#fff",
              "border": "1px solid #eeecec"
            },
            "@media all and (orientation: landscape)": {
              "body:not(.touchscreen) header": {
                "will-change": "auto",
                "transition": "all 0.4s ease-in-out"
              },
              ".landscape-image ~ .portrait-image": {
                "opacity": "0",
                "display": "none"
              }
            },
            ".wrap.text-wrap": {
              "max-width": "82rem",
              "margin-left": "auto",
              "margin-right": "auto"
            },
            ".wrap.full-width": {
              "padding-left": "0 !important",
              "padding-right": "0 !important",
              "max-width": "calc(100% - 6rem) !important"
            },
            ".wrap img": {
              "width": "auto",
              "height": "auto",
              "max-width": "100%"
            },
            ".content > section:not(.hero):first-child": {
              "padding-top": "5rem"
            },
            ".align-left": {
              "text-align": "left"
            },
            ".align-center": {
              "text-align": "center"
            },
            ".align-right": {
              "text-align": "right"
            },
            ".text_block-section + .text-wrap, .flexible-section:not(.video-section) + .flexible-section:not(.video-section) > .wrap:first-child, .section-title-wrap + .flexible-section > .wrap:first-child, .body-copy-with-intro + .hidden-content > .flexible-section > .wrap:first-child, .wrap + .wrap": {
              "padding-top": "0"
            },
            ".fullscreen": {
              "position": "relative",
              "height": "100vh",
              "overflow": "hidden",
              "-webkit-clip-path": "inset(0 0 0 0)",
              "clip-path": "inset(0 0 0 0)"
            },
            ".fullscreen .wrap": {
              "margin": "0",
              "z-index": "4",
              "padding-top": "0",
              "padding-bottom": "0"
            },
            ".fullscreen .fixed-wrap": {
              "position": "absolute",
              "top": "0",
              "left": "0",
              "width": "100%",
              "height": "100%",
              "z-index": "0"
            },
            ".fullscreen .fixed-wrap.fixed": {
              "position": "fixed"
            },
            "@supports (-ms-ime-align: auto)": {
              ".fullscreen": {
                "clip-path": "none !important"
              },
              ".fullscreen .fixed-wrap.fixed": {
                "position": "absolute !important"
              }
            },
            "@media all and (-ms-high-contrast: none), (-ms-high-contrast: active)": {
              ".fullscreen": {
                "clip-path": "none !important"
              },
              ".fullscreen .fixed-wrap.fixed": {
                "position": "absolute !important"
              }
            },
            ".fullscreen .slide-image": {
              "width": "100%",
              "height": "100%",
              "position": "relative",
              "z-index": "0"
            },
            ".fullscreen .slide-text": {
              "position": "absolute",
              "top": "0",
              "left": "0",
              "width": "100%",
              "height": "100%",
              "display": "flex",
              "-webkit-flex-direction": "column",
              "flex-direction": "column",
              "-webkit-align-items": "center",
              "align-items": "center",
              "-webkit-justify-content": "center",
              "justify-content": "center",
              "z-index": "2"
            },
            ".fullscreen a": {
              "color": "#ffffff"
            },
            ".slide-image + .slide-text, .slide-text.over-image": {
              "color": "#fff",
              "background": "radial-gradient(ellipse 50% 50%, rgba(18, 18, 18, 0.125), rgba(18, 18, 18, 0))"
            },
            ".hero .slide-image": {
              "opacity": "0.8"
            },
            ".hero.auto-height": {
              "padding": "5rem 0"
            },
            ".hero.auto-height .slide-text": {
              "position": "relative"
            },
            ".home-hero": {
              "position": "relative",
              "z-index": "1"
            },
            ".home-hero + section": {
              "z-index": "0"
            },
            ".home-hero + section + section": {
              "z-index": "1"
            },
            ".home-hero .safari-fix": {
              "position": "absolute",
              "top": "0",
              "background": "transparent !important",
              "overflow": "hidden"
            },
            ".home-hero .safari-fix a": {
              "display": "block",
              "position": "relative",
              "width": "100vw",
              "height": "100%",
              "background": "transparent !important",
              "opacity": "0"
            },
            "body > .fullscreen": {
              "position": "fixed",
              "top": "0",
              "left": "0",
              "width": "100%",
              "height": "100%",
              "z-index": "2"
            },
            "body > .fullscreen .slide-image": {
              "opacity": "0.8"
            },
            "body > .fullscreen button, .project-hero .slide-text button": {
              "background-color": "#fff",
              "color": "#121212",
              "border-color": "#fff",
              "opacity": "0"
            },
            ".page-hero .slide-image": {
              "position": "fixed"
            },
            ".page-hero .slide-text": {
              "position": "relative",
              "height": "auto",
              "margin": "100vh auto 25vh",
              "background": "transparent"
            },
            "@media all and (orientation: portrait)": {
              ".page-hero .wrap h4": {
                "font-size": "calc(2rem + 0.25vh)"
              },
              ".portrait-image ~ .landscape-image": {
                "opacity": "0",
                "visibility": "hidden",
                "display": "none"
              }
            },
            ".fullscreen .slide-text button:only-child": {
              "margin-top": "2rem"
            },
            ".offblack-bg": {
              "background-color": "#231f20"
            },
            ".offblack-bg a:not(.button):not([title]):not(:hover)": {
              "background": "linear-gradient(#231f20 calc(100% - 1px), #ffffff calc(100% - 1px))",
              "text-shadow": "0 1px #231f20, -1px 0 #231f20, 1px 0 #231f20, -2px 0 #231f20, 2px 0 #231f20"
            },
            ".hidden": {
              "display": "none",
              "visibility": "hidden"
            },
            "H1": {
              "color": "#ffffff"
            },
            "sectionzen": {
              "display": "block"
            },
            ".zen-active": {},
            ".mbr-section-title": {
              "color": "#ffffff"
            }
          },
          "_customHTML": "<section data-bs-version=\"5.1\" group=\"Zen2cool Parallax\" class=\"hero home-hero offblack-bg white-text\" id=\"home-hero\" plugins=\"Zen2cool-Parallax\">\n\n    <mbr-parameters>\n\n        <header>Parallax v0.9</header>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\">\n        <header>Dots (Work on prev/pub)</header>\n        <input type=\"checkbox\" title=\"On/Off\" name=\"showDots\">\n        <input type=\"checkbox\" title=\"Right/Left\" name=\"showPossDots\" condition=\"showDots\">\n        <input type=\"range\" name=\"DotsSpacing\" title=\"Spacing\" min=\"1\" max=\"100\" step=\"1\" value=\"1\" condition=\"showDots\">\n        <input type=\"range\" name=\"DotsSize\" title=\"Dots Size\" min=\"1\" max=\"20\" step=\"1\" value=\"15\" condition=\"showDots\">\n        <input type=\"range\" name=\"DotsActSize\" title=\"Dots Act Size\" min=\"1\" max=\"2\" step=\"0.1\" value=\"1.7\" condition=\"showDots\">\n        <input type=\"color\" title=\"Dots Color\" name=\"IndicColor\" value=\"#ffffff\" condition=\"showDots\"> \n        <input type=\"color\" title=\"Dots Act Color\" name=\"IndicColorAct\" value=\"#e43f3f\" condition=\"showDots\"> \n        <input type=\"range\" name=\"DotsRadius\" title=\"Radius\" min=\"0\" max=\"100\" step=\"1\" value=\"100\" condition=\"showDots\">\n        <header>Blocs</header>\n        <input type=\"range\" name=\"NbrofBar\" title=\"Nbr. of Block\" min=\"1\" max=\"5\" step=\"1\" value=\"3\">\n        <header>Block 1</header>\n        <input type=\"image\" inline title=\"Image\" name=\"Test1\" value=\"@PROJECT_PATH@/assets/images/rajlakshami-palace-ultra-luxury-neo-classical-bungalow-mahaconstro201-3840x2560.webp\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"OpacityImage1\" min=\"0\" max=\"1\" step=\"0.1\" value=\"1\">\n        <input type=\"range\" inline title=\"Blur\" name=\"BlurImage1\" min=\"0\" max=\"20\" step=\"1\" value=\"0\">\n        <input type=\"range\" inline title=\"Color\" name=\"GrayImage1\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0\"> \n        <input type=\"checkbox\" title=\"Button\" name=\"showButton1\">\n        <header condition=\"NbrofBar > 1\">Block 2</header>\n        <input type=\"image\" inline title=\"Image\" name=\"Test2\" value=\"@PROJECT_PATH@/assets/images/ultra-luxury-bungalow-interior-parite-solapur-mahaconstro209-4000x3000.webp\" selected condition=\"NbrofBar > 1\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"OpacityImage2\" min=\"0\" max=\"1\" step=\"0.1\" value=\"1\" condition=\"NbrofBar > 1\">\n        <input type=\"range\" inline title=\"Blur\" name=\"BlurImage2\" min=\"0\" max=\"100\" step=\"1\" value=\"0\" condition=\"NbrofBar > 1\">\n        <input type=\"range\" inline title=\"Color\" name=\"GrayImage2\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0\" condition=\"NbrofBar > 1\"> \n        <input type=\"checkbox\" title=\"Button\" name=\"showButton2\" condition=\"NbrofBar > 1\">\n        <header condition=\"NbrofBar > 2\">Block 3</header>\n        <input type=\"image\" inline title=\"Image\" name=\"Test3\" value=\"@PROJECT_PATH@/assets/images/sstf12-1890x1417.webp\" selected condition=\"NbrofBar > 2\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"OpacityImage3\" min=\"0\" max=\"1\" step=\"0.1\" value=\"1\" condition=\"NbrofBar > 2\">\n        <input type=\"range\" inline title=\"Blur\" name=\"BlurImage3\" min=\"0\" max=\"20\" step=\"1\" value=\"0\" condition=\"NbrofBar > 2\"> \n        <input type=\"range\" inline title=\"Color\" name=\"GrayImage3\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0\" condition=\"NbrofBar > 2\">\n        <input type=\"checkbox\" title=\"Button\" name=\"showButton3\" condition=\"NbrofBar > 2\">\n        <header condition=\"NbrofBar > 3\">Block 4</header>\n    \n        <input type=\"image\" inline title=\"Image\" name=\"Test4\" value=\"https://www.unsitepourtous.be/mobi/flower4.jpg\" selected condition=\"NbrofBar > 3\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"OpacityImage4\" min=\"0\" max=\"1\" step=\"0.1\" value=\"1\" condition=\"NbrofBar > 3\">\n        <input type=\"range\" inline title=\"Blur\" name=\"BlurImage4\" min=\"0\" max=\"20\" step=\"1\" value=\"0\" condition=\"NbrofBar > 3\">\n        <input type=\"range\" inline title=\"Color\" name=\"GrayImage4\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0\" condition=\"NbrofBar > 3\"> \n        <input type=\"checkbox\" title=\"Button\" name=\"showButton4\" checked condition=\"NbrofBar > 3\">\n        <header condition=\"NbrofBar > 4\">Block 5</header>\n        <input type=\"image\" inline title=\"Image\" name=\"Test5\" value=\"https://www.unsitepourtous.be/mobi/flower5.jpg\" selected condition=\"NbrofBar > 4\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"OpacityImage5\" min=\"0\" max=\"1\" step=\"0.1\" value=\"1\" condition=\"NbrofBar > 4\">\n        <input type=\"range\" inline title=\"Blur\" name=\"BlurImage5\" min=\"0\" max=\"20\" step=\"1\" value=\"0\" condition=\"NbrofBar > 4\">\n        <input type=\"range\" inline title=\"Color\" name=\"GrayImage5\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0\" condition=\"NbrofBar > 4\">\n        <input type=\"checkbox\" title=\"Button\" name=\"showButton5\" checked condition=\"NbrofBar > 4\">\n    \n    </mbr-parameters>\n   <main mbr-if=\"showDots\">\n        <aside>\n    <ul>\n      <li>\n        <a class=\"indicator active\" href=\"#first\"></a>\n      </li>\n      <li mbr-if=\"NbrofBar > 1\">\n        <a class=\"indicator\" href=\"#second\"></a>\n      </li>\n      <li mbr-if=\"NbrofBar > 2\">\n        <a class=\"indicator\" href=\"#third\"></a>\n      </li>\n            <li mbr-if=\"NbrofBar > 3\">\n        <a class=\"indicator\" href=\"#four\"></a>\n      </li>\n            <li mbr-if=\"NbrofBar > 4\">\n        <a class=\"indicator\" href=\"#five\"></a>\n      </li>\n        <li>\n        <a class=\"indicator d-none\" href=\"#third\"></a>\n      </li>\n        <li>\n        <a class=\"indicator d-none\" href=\"#four\"></a>\n      </li>\n         <li>\n        <a class=\"indicator d-none\" href=\"#five\"></a>\n      </li>\n    </ul>\n  </aside>\n  </main>\n  \n  \n  <sectionzen id=\"first\">\n    \t\t<div class=\"fullscreen\">\n            <div class=\"fixed-wrap fixed\">\n\t\t\t\t<div class=\"slide-image object-cover\">\n                <div class=\"imgtest landscape-image\" alt data-sizes=\"auto\"></div></div>\n\t\t\t\t<div class=\"slide-text over-image\">\n\t\t\t\t\t<div class=\"wrap text-wrp align-center\">\n\t\t\t\t\t\t<h3 class=\"widont balance-text mbr-section-title mbr-fonts-style align-center mb-4\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-5\"><b>ARCHITECTURE</b></h3>\n\t\t\t\t\t                <h4 class=\"mbr-section-subtitle align-center mbr-fonts-style mb-4\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-7\">We design distinctive architectural spaces that balance aesthetics, functionality, and sustainability, transforming ideas into thoughtfully planned built environments.</h4>\n                 <div class=\"mbr-section-btn align-center\" mbr-if=\"showButton1\" mbr-buttons mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-white-outline\" href data-app-placeholder=\"Type Text\">Learn more</a></div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n        </div>\n    </sectionzen>\n    <sectionzen id=\"second\">\n\t\t    \t\t<div class=\"fullscreen\" mbr-if=\"NbrofBar > 1\">\n              <div class=\"fixed-wrap fixed\">\n\t\t\t\t<div class=\"slide-image object-cover\">\n               <div class=\"imgtest1 landscape-image\" alt data-sizes=\"auto\"></div></div>\n\t\t\t\t\t\t\t<div class=\"slide-text over-image\">\n\t\t\t\t\t<div class=\"wrap text-wrp align-center\">\n\t\t\t\t\t\t<h3 class=\"widont balance-text mbr-section-title mbr-fonts-style align-center mb-4\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-5\"><b>INTERIOR</b></h3>\t\t\t\t\t\t                <h4 class=\"mbr-section-subtitle align-center mbr-fonts-style mb-4\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-7\">We craft refined interiors that combine comfort, elegance, and functionality, creating personalized spaces that reflect your lifestyle and vision.</h4>\n                    <div class=\"mbr-section-btn align-center\" mbr-if=\"showButton2\" mbr-buttons mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-white-outline\" href data-app-placeholder=\"Type Text\">Learn more</a></div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t  </div>\n        </div>\n  </sectionzen>\n  <sectionzen id=\"third\">\n\t\t    \t\t<div class=\"fullscreen\" mbr-if=\"NbrofBar > 2\">\n              <div class=\"fixed-wrap fixed\">\n\t\t\t\t<div class=\"slide-image object-cover\">\n <div class=\"imgtest2 landscape-image\" alt data-sizes=\"auto\"></div></div>\n\t\t\t\t<div class=\"slide-text over-image\">\n\t\t\t\t\t<div class=\"wrap text-wrp align-center\">\n<h3 class=\"widont balance-text mbr-section-title mbr-fonts-style align-center mb-4\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-5\"><b>LANDSCAPE</b></h3>\n\t\t\t\t\t\t\t\t\t\t\t                <h4 class=\"mbr-section-subtitle align-center mbr-fonts-style mb-4\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-7\">We shape inspiring outdoor environments through thoughtful planting, elegant pathways, and harmonious integration of architecture with nature.</h4>\n                    <div class=\"mbr-section-btn align-center\" mbr-if=\"showButton3\" mbr-buttons mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-white-outline\" href data-app-placeholder=\"Type Text\">Learn more</a></div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t  </div>\n        </div>\n  </sectionzen>\n  <sectionzen id=\"four\">\n\t\t      \t<div class=\"fullscreen\" mbr-if=\"NbrofBar > 3\">\n             <div class=\"fixed-wrap fixed\">\n\t\t\t\t<div class=\"slide-image object-cover\">\n <div class=\"imgtest3 landscape-image\" alt data-sizes=\"auto\"></div></div>\n\t\t\t\t<div class=\"slide-text over-image\">\n\t\t\t\t\t<div class=\"wrap text-wrp align-center\">\n\t\t\t\t\t\t<h3 class=\"widont balance-text mbr-section-title mbr-fonts-style align-center mb-4\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-1\"><b>Parallax Hello World 4</b></h3>\n\t\t\t\t\t\t\t\t\t\t                <h4 class=\"mbr-section-subtitle align-center mbr-fonts-style mb-4\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-7\">\n                   Subtitle 4</h4>\n                    <div class=\"mbr-section-btn align-center\" mbr-if=\"showButton4\" mbr-buttons mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-white-outline\" href data-app-placeholder=\"Type Text\">Learn more</a></div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t  </div>\n        </div>\n  </sectionzen>\n  <sectionzen id=\"five\">\n\t\t<div class=\"fullscreen\" mbr-if=\"NbrofBar > 4\">\n            <div class=\"fixed-wrap fixed\">\n\t\t\t\t<div class=\"slide-image object-cover\">\n                <div class=\"imgtest4 landscape-image\" alt data-sizes=\"auto\"></div></div>\n\t\t\t\t<div class=\"slide-text over-image\">\n\t\t\t\t\t<div class=\"wrap text-wrp align-center\">\n\t\t\t\t\t<h3 class=\"widont balance-text mbr-section-title mbr-fonts-style align-center mb-4\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-1\"><b>Parallax Hello World 5</b></h3>\n\t\t\t\t\t\t\t\t\t\t\t                <h4 class=\"mbr-section-subtitle align-center mbr-fonts-style mb-4\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-7\">\n                   Subtitle 5</h4>\n                    <div class=\"mbr-section-btn align-center\" mbr-buttons mbr-if=\"showButton5\" mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-white-outline\" href data-app-placeholder=\"Type Text\">Learn more</a></div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n        </div>\n  </sectionzen>\n  \n\n<script defer>\n  // Scope : ton conteneur de nav (adapte le sélecteur)\n  const nav = document.querySelector('.zen-nav') || document;\n  // Indicateurs : préfère un attribut/classe spécifique à toi\n  const indicators = nav.querySelectorAll('a.indicator');\n  const sections   = document.querySelectorAll('sectionzen');\n\n  const resetCurrentActiveIndicator = () => {\n    const active = nav.querySelector('a.indicator.zen-active');\n    if (active) active.classList.remove('zen-active');\n  };\n\n  const observer = new IntersectionObserver((entries) => {\n    entries.forEach((entry) => {\n      if (!entry.isIntersecting) return;\n      const id = entry.target.id;\n      if (!id) return;\n      const link = nav.querySelector(`a.indicator[href=\"#${CSS.escape(id)}\"]`);\n      if (!link) return;\n      resetCurrentActiveIndicator();\n      link.classList.add('zen-active');\n    });\n  }, { threshold: 0.75 });\n\n  indicators.forEach((indicator) => {\n    indicator.addEventListener('click', (e) => {\n      e.preventDefault();\n      const targetSel = indicator.getAttribute('href');\n      const target = targetSel && document.querySelector(targetSel);\n      if (target) target.scrollIntoView({ behavior: 'smooth' });\n      resetCurrentActiveIndicator();\n      indicator.classList.add('zen-active');\n    });\n  });\n\n  sections.forEach((sec) => observer.observe(sec));\n\n  // État initial facultatif\n  if (!nav.querySelector('a.indicator.zen-active') && indicators[0]) {\n    indicators[0].classList.add('zen-active');\n  }\n</script>\n\n\t\t\n\n                <div class=\"safari-fix\" id=\"safari-fix\"></div>\n\n\t\n\t</section>",
          "_anchor": "design-block-6",
          "_isUserblock": true,
          "_cid": "vyu3Ggkfc7",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".social-row": {
              ".soc-item": {
                "display": "inline-block",
                "text-align": "center",
                "margin-bottom": "1rem",
                "margin-right": ".7rem",
                ".mbr-iconfont": {
                  "font-size": "32px",
                  "border-radius": "50%",
                  "padding": "0.6rem",
                  "border": "2px solid @socialIconColor",
                  "transition": "all 0.3s",
                  "color": "@socialIconColor",
                  "&:hover": {
                    "background-color": "@socialIconColor",
                    "color": "contrast(@socialIconColor)"
                  }
                }
              }
            },
            ".mbr-section-subtitle": {
              "color": "#e6c63b"
            },
            ".mbr-text, .mbr-section-btn, .social-row": {
              "color": "#ffffff"
            }
          },
          "_name": "header13",
          "_sourceTheme": "mobirise5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"header13\" group=\"Headers\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"1\" condition=\"fullScreen == false\">\n\n        <input type=\"range\" inline name=\"textWidth\" title=\"Width\" min=\"4\" max=\"12\" value=\"7\" step=\"1\">\n        <select title=\"Align\" name=\"contentAlign\">\n            <option value>Left</option>\n            <option value=\"justify-content-center\" selected>Center</option>\n            <option value=\"justify-content-end\">Right</option>\n        </select>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\">\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubitle\">\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n        <input type=\"checkbox\" title=\"Social\" name=\"showSocial\">\n        <input type=\"range\" name=\"socialCount\" title=\"Count\" min=\"1\" max=\"5\" step=\"1\" value=\"3\" condition=\"showSocial\">\n        <input type=\"color\" title=\"Color\" name=\"socialIconColor\" value=\"#000000\" condition=\"showSocial\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/background15.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#40b0bf\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@PROJECT_PATH@/assets/images/background13.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.2\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div class=\"align-center\" mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row {{contentAlign}}\">\n            <div class=\"col-12 col-lg-{{textWidth}}\">\n                <h2 class=\"mbr-section-title mbr-fonts-style mb-3\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\"><b>Designing Spaces.</b><br></h2>\n                <h2 class=\"mbr-section-subtitle mbr-fonts-style mb-3\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-2\" mbr-if=\"showSubitle\"><b>Defining Lifestyles.</b></h2>\n                <p class=\"mbr-text mbr-fonts-style mb-3\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn, .social-row\"><b>Discover a collection of projects that reflect our design philosophy, attention to detail, and pursuit of meaningful spaces</b><br></p>\n                <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn mt-3\" mbr-if=\"showButtons\"><a class=\"btn btn-primary\" data-app-placeholder=\"Type Text\"><span class=\"mobi-mbri mobi-mbri-arrow-down mbr-iconfont mbr-iconfont-btn\"></span>Selected Works</a></div>\n                <div class=\"social-row display-7 mt-5\" mbr-if=\"showSocial\">\n                    <div class=\"soc-item\">\n                        <a href=\"https://twitter.com/mobirise\" target=\"_blank\">\n                            <span mbr-icon class=\"mbr-iconfont socicon socicon-facebook\"></span>\n                        </a>\n                    </div>\n                    <div class=\"soc-item\" mbr-if=\"socialCount>1\">\n                        <a href=\"https://twitter.com/mobirise\" target=\"_blank\">\n                            <span mbr-icon class=\"mbr-iconfont socicon socicon-twitter\"></span>\n                        </a>\n                    </div>\n                    <div class=\"soc-item\" mbr-if=\"socialCount>2\">\n                        <a href=\"https://twitter.com/mobirise\" target=\"_blank\">\n                            <span mbr-icon class=\"mbr-iconfont socicon socicon-instagram\"></span>\n                        </a>\n                    </div>\n                    <div class=\"soc-item\" mbr-if=\"socialCount>3\">\n                        <a href=\"https://twitter.com/mobirise\" target=\"_blank\">\n                            <span mbr-icon class=\"mbr-iconfont socicon socicon-youtube\"></span>\n                        </a>\n                    </div>\n                    <div class=\"soc-item\" mbr-if=\"socialCount>4\">\n                        <a href=\"https://twitter.com/mobirise\" target=\"_blank\">\n                            <span mbr-icon class=\"mbr-iconfont socicon socicon-telegram\"></span>\n                        </a>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_anchor": "header13-v",
          "_isUserblock": true,
          "_cid": "vyvfTQSkm6",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)",
              "& when (@overlay)": {
                ".mbr-overlay": {
                  "background": "@overlayColor",
                  "opacity": "@overlayOpacity"
                }
              }
            },
            "img, .item-img": {
              "width": "100%",
              "& when (@autoSize)": {
                "height": "100%",
                "object-fit": "cover",
                "& when (@showCardTitle)": {
                  "height": "(@imageHeight * 100px)",
                  "object-fit": "cover"
                },
                "& when (@showCardSubtitle)": {
                  "height": "(@imageHeight * 100px)",
                  "object-fit": "cover"
                },
                "& when (@showText)": {
                  "height": "(@imageHeight * 100px)",
                  "object-fit": "cover"
                },
                "& when (@showButtons)": {
                  "height": "(@imageHeight * 100px)",
                  "object-fit": "cover"
                }
              }
            },
            ".item:focus, span:focus": {
              "outline": "none"
            },
            ".item": {
              "cursor": "pointer",
              "margin-bottom": "2rem",
              "position": "relative"
            },
            "& when not (@spacing)": {
              ".row": {
                "margin-left": "0",
                "margin-right": "0"
              },
              ".item": {
                "padding": "0",
                "margin": "0"
              }
            },
            ".item-wrapper": {
              "position": "unset",
              "border-radius": "4px",
              "background": "@cardsBg",
              "height": "100%",
              "display": "flex",
              "flex-flow": "column nowrap",
              "@media (min-width: 992px)": {
                "& when (@showButtons)": {
                  ".item-content": {
                    "padding": "2rem 2rem 0"
                  },
                  ".item-footer": {
                    "padding": "0 2rem 2rem"
                  }
                },
                "& when not (@showButtons)": {
                  ".item-content": {
                    "padding": "2rem"
                  }
                }
              },
              "@media (max-width: 991px)": {
                "& when (@showButtons)": {
                  ".item-content": {
                    "padding": "1rem 1rem 0"
                  },
                  ".item-footer": {
                    "padding": "0 1rem 1rem"
                  }
                },
                "& when not (@showButtons)": {
                  ".item-content": {
                    "padding": "1rem"
                  }
                }
              }
            },
            ".mbr-section-btn": {
              "margin-top": "auto !important"
            },
            ".mbr-section-title": {
              "color": "#232323"
            },
            ".item-title": {
              "color": "#ffffff",
              "text-align": "center"
            }
          },
          "_name": "gallery1",
          "_sourceTheme": "mobirise5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"gallery1\" group=\"Sliders & Galleries\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"1\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"0\">\n        <select title=\"Columns\" name=\"cardsWidth\">\n            <option value=\"12\">1</option>\n            <option value=\"6\">2</option>\n            <option value=\"4\">3</option>\n            <option value=\"3\" selected>4</option>\n        </select>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" name=\"showTitle\" title=\"Title\">\n        <input type=\"checkbox\" name=\"showSubtitle\" title=\"Subtitle\">\n        <header>Cards</header>\n        <input type=\"checkbox\" name=\"autoSize\" title=\"Auto Size\">\n        <input type=\"range\" name=\"imageHeight\" title=\"Height\" min=\"1\" max=\"5\" step=\"1\" value=\"3\" condition=\"autoSize && !(showButtons==false && showCardSubtitle==false && showCardTitle==false && showText==false)\">\n        <input type=\"checkbox\" title=\"Spacing\" name=\"spacing\" checked>\n        <input type=\"checkbox\" name=\"showCardTitle\" title=\"Title\">\n        <input type=\"checkbox\" name=\"showCardSubtitle\" title=\"Subtitle\" checked>\n        <input type=\"checkbox\" name=\"showText\" title=\"Text\">\n        <input type=\"checkbox\" name=\"showButtons\" title=\"Buttons\" checked>\n        <input type=\"color\" name=\"cardsBg\" title=\"BG\" value=\"#40b0bf\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" required>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background3.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#40b0bf\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#fafafa\" condition=\"overlay && bg.type == 'image'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.1\" condition=\"overlay && bg.type == 'image'\">\n    </mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\"></div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"mbr-section-head\" mbr-if=\"showTitle || showSubtitle\">\n            <h4 class=\"mbr-section-title mbr-fonts-style align-center mb-0\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\">\n                <b>Gallery</b></h4>\n            <h5 class=\"mbr-section-subtitle mbr-fonts-style align-center mb-0 mt-2\" mbr-theme-style=\"display-5\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\">\n                Gallery Subtitle</h5>\n        </div>\n        <div class=\"row mt-4\">\n            <div class=\"item features-image col-12 col-md-6 col-lg-{{cardsWidth}} active\">\n                <div class=\"item-wrapper\">\n                    <div class=\"item-img\">\n                        <img src=\"@PROJECT_PATH@/assets/images/sct2-2000x1333.webp\" alt=\"Ultra-luxury neo-classical bungalow, Rajlakshami Palace, featuring grand columns, ornate architectural detailing, and a formal entrance designed by Mahaconstro Architects.\" data-slide-to=\"0\" data-bs-slide-to=\"0\">\n                    </div>\n                    <div class=\"item-content\" mbr-if=\"showCardTitle || showCardSubtitle || showText || showButtons\">\n                        <h5 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\">\n                            <a href=\"page1.html\" class=\"text-primary\"><b>Card Title</b></a>\n                        </h5>\n                        <h1 class=\"item-subtitle mbr-fonts-style mt-1\" mbr-theme-style=\"display-4\" data-app-selector=\".item-subtitle\" mbr-if=\"showCardSubtitle\">\n                            <b>Rajlakshami palace</b></h1>\n                        <p class=\"mbr-text mbr-fonts-style mt-3\" mbr-if=\"showText\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text, .mbr-section-btn\">\n                            Card Text. You don't have to code to create a site. Select one of available themes in the\n                            Mobirise Site Builder.\n                        </p>\n                    </div>\n                    <div class=\"mbr-section-btn item-footer mt-2\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\" mbr-buttons mbr-theme-style=\"display-4\"><a href=\"page2.html\" class=\"btn btn-primary item-btn\" data-app-placeholder=\"Type Text\">View Project<br></a></div>\n                </div>\n            </div>\n            <div class=\"item features-image col-12 col-md-6 col-lg-{{cardsWidth}}\">\n                <div class=\"item-wrapper\">\n                    <div class=\"item-img\">\n                        <img src=\"@PROJECT_PATH@/assets/images/m9-2000x1500.webp\" alt=\"Ultra-luxury bungalow lounge in Parite, Solapur, featuring designer seating, a decorative water feature, and statement ceiling lighting by Mahaconstro Architects.\" title data-slide-to=\"1\" data-bs-slide-to=\"1\">\n                    </div>\n                    <div class=\"item-content\" mbr-if=\"showCardTitle || showCardSubtitle || showText || showButtons\">\n                        <h5 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\">\n                            <b>Card Title</b>\n                        </h5>\n                        <h1 class=\"item-subtitle mbr-fonts-style mt-1\" mbr-theme-style=\"display-4\" data-app-selector=\".item-subtitle\" mbr-if=\"showCardSubtitle\">\n                            <b style>Residential interior</b></h1>\n                        <p class=\"mbr-text mbr-fonts-style mt-3\" mbr-if=\"showText\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text, .mbr-section-btn\">Card Text. You don't have to code to create\n                            a site. Select one of available themes in the Mobirise Site Builder.</p>\n                    </div>\n                    <div class=\"mbr-section-btn item-footer mt-2\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\" mbr-buttons mbr-theme-style=\"display-4\"><a href=\"page17.html\" class=\"btn btn-primary item-btn\" data-app-placeholder=\"Type Text\">View Project</a></div>\n                </div>\n            </div><div class=\"item features-image col-12 col-md-6 col-lg-{{cardsWidth}}\">\n                <div class=\"item-wrapper\">\n                    <div class=\"item-img\">\n                        <img src=\"@PROJECT_PATH@/assets/images/gp1-1890x1417.webp\" alt=\"Contemporary luxury plotting entrance gateway at Golden Park in Mohol, Solapur, designed by Mahaconstro Architects.\" title data-slide-to=\"2\" data-bs-slide-to=\"2\">\n                    </div>\n                    <div class=\"item-content\" mbr-if=\"showCardTitle || showCardSubtitle || showText || showButtons\">\n                        <h5 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\">\n                            <b>Card Title</b>\n                        </h5>\n                        <h1 class=\"item-subtitle mbr-fonts-style mt-1\" mbr-theme-style=\"display-4\" data-app-selector=\".item-subtitle\" mbr-if=\"showCardSubtitle\"><b style>Golden park</b></h1>\n                        <p class=\"mbr-text mbr-fonts-style mt-3\" mbr-if=\"showText\" mbr-theme-style=\"display-7\" data-app